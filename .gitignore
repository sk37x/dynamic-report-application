.yarn/*

# ยกเว้นโฟลเดอร์สำหรับ Plugins, Releases, Patches และ SDKs
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Ignore ไฟล์ Cache และ Log ของ Yarn
.yarn/cache
.yarn/build-state.yml
.yarn/install-state.gz


# ignore zip files
frontend/.next.zip
