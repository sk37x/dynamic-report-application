# Copy to .env.local for a NEW checkout; merge if a file already exists.
# Server-side Next.js rewrite target. No /api suffix.
# This value is used when building the rewrites; rebuild after changing it.
API_PROXY_TARGET=http://127.0.0.1:3001

# Browser API base URL is /api in config/api.config.ts.
# Do not put database passwords or JWT signing secrets in frontend env.

