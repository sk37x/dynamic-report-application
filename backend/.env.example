# Base environment: auth disabled, no database connections selected.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Optional AUTH: uncomment and fill when auth is enabled in source config.
# Generate a unique 32-byte random hex secret; never commit the real value.
# AUTH_JWT_SECRET_HEX=
# AUTH_JWT_ISSUER=template-api
# AUTH_JWT_AUDIENCE=template-web
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_SESSION_TTL_SECONDS=604800

# Optional Oracle MAIN: uncomment and fill when oracle: ['MAIN'] is selected.
# ORACLE_CLIENT_LIB_DIR=C:/oracle/instantclient_19_30
# ORACLE_MAIN_USER=APP_SCHEMA
# ORACLE_MAIN_PASSWORD=
# ORACLE_MAIN_CONNECT_STRING=db-host:1521/service_name

# MSSQL: use the variable names read by your MssqlModule factory.
# This example documents the Oracle path verified in the current app.
# Integration-test credentials belong in .env.integration.local, not here.

